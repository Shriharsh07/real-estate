{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/real-estate-app/browser"
      }
    }
  ],
  "functions": {
    "api/index.go": {
      "runtime": "vercel-go@3.1.2"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.go" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}